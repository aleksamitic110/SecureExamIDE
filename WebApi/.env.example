# Copy this file to .env before running `docker compose up`. The real .env is git-ignored, so no
# credential ever reaches the repository - not even a local one.
#
# Every service in docker-compose.yml reads .env, so each one picks out the variables it
# understands and ignores the rest.

# --- PostgreSQL (read by the postgres image) ---
POSTGRES_DB=secure-exam-ide
POSTGRES_USER=replace-me
POSTGRES_PASSWORD=replace-me

# --- MinIO (read by the minio image and by the one-shot bucket creator) ---
MINIO_ROOT_USER=replace-me
MINIO_ROOT_PASSWORD=replace-me
MINIO_BUCKET=exam-packages

# --- The API container ---
# ASP.NET Core maps a double underscore to a nested configuration key, so these override the
# matching entries in appsettings.json. The host names are the compose service names: inside a
# container "localhost" is the container itself, not the machine running Docker.
ConnectionStrings__Database=Host=postgres;Port=5432;Database=secure-exam-ide;Username=replace-me;Password=replace-me;Include Error Detail=true
Storage__Endpoint=minio:9000
Storage__AccessKey=replace-me
Storage__SecretKey=replace-me
Storage__Bucket=exam-packages
Storage__UseSsl=false
Registration__ProfessorRegistrationCode=replace-me
# The address a browser or desktop client reaches MinIO at, used only for signing download
# URLs. Inside Docker the API says "minio:9000", but a client cannot resolve that.
Storage__PublicEndpoint=localhost:9000

# --- Mail ---
# The mailpit container catches every message the API sends; read them at http://localhost:8025.
# For a real provider, set its host and port, Email__UseSsl=true, and add Email__Username and
# Email__Password. With no Email__Host at all the API only logs that it would have sent a mail.
Email__Host=mailpit
Email__Port=1025
Email__UseSsl=false
Email__FromAddress=no-reply@secureexamide.local
