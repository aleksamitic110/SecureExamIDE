<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SecureExamIDE.Client.ViewModels"
        x:Class="SecureExamIDE.Client.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="SecureExamIDE"
        Width="1000" Height="720"
        MinWidth="520" MinHeight="560"
        WindowStartupLocation="CenterScreen">

  <!-- The window only hosts the current page; ViewLocator turns the page's view model into its view. -->
  <ContentControl Content="{Binding CurrentPage}" />

</Window>
