<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SecureExamIDE.Client.ViewModels.Home"
             x:Class="SecureExamIDE.Client.Views.Home.StudentHomeView"
             x:DataType="vm:StudentHomeViewModel">
  <DockPanel Margin="32">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,24">
      <StackPanel Spacing="4">
        <TextBlock Classes="title" Text="{Binding Greeting}" />
        <TextBlock Classes="info" Text="{Binding Details}" />
      </StackPanel>
      <Button Grid.Column="1" VerticalAlignment="Top" Content="Sign out of this computer"
              Command="{Binding SignOutCommand}" />
    </Grid>

    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <StackPanel Spacing="2">
        <TextBlock Classes="heading" Text="Available exams" />
        <TextBlock Classes="info"
                   Text="Download an exam at home, before the day of the exam. The tasks stay locked until the professor gives out the code." />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
        <Button Content="Exams on this computer" Command="{Binding OpenDownloadedExamsCommand}" />
        <Button Content="Refresh" Command="{Binding LoadCommand}" />
      </StackPanel>
    </Grid>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Previous" Command="{Binding PreviousPageCommand}" />
      <TextBlock VerticalAlignment="Center" Text="{Binding PageLabel}" />
      <Button Content="Next" Command="{Binding NextPageCommand}" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Top" Spacing="8">
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
      <TextBlock Classes="error" Text="{Binding ErrorMessage}"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Classes="info" Text="No exams have been published yet." IsVisible="{Binding IsEmpty}" />
    </StackPanel>

    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Exams}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="12" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CatalogExamItem">
            <Border Classes="item">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Classes="itemTitle" Text="{Binding Title}" />
                    <Border Classes="badge" IsVisible="{Binding HasDownloadedSitting}">
                      <TextBlock Text="Downloaded" />
                    </Border>
                  </StackPanel>
                  <TextBlock Classes="info" Text="{Binding Subject}" />
                  <TextBlock Classes="info" Text="{Binding ProfessorName, StringFormat='Professor {0}'}" />
                  <TextBlock Classes="info" Text="{Binding Contents}" />
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Center" Classes="accent" Content="Open"
                        Command="{Binding $parent[ItemsControl].((vm:StudentHomeViewModel)DataContext).OpenExamCommand}"
                        CommandParameter="{Binding}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
