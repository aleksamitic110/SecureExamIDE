<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SecureExamIDE.Client.ViewModels.ExamDay"
             x:Class="SecureExamIDE.Client.Views.ExamDay.DownloadedExamsView"
             x:DataType="vm:DownloadedExamsViewModel">
  <DockPanel Margin="32">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,24">
      <StackPanel Spacing="4">
        <TextBlock Classes="title" Text="Exams on this computer" />
        <TextBlock Classes="info" Text="{Binding ConnectionNote}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
        <Button Content="Back to the catalog" IsVisible="{Binding IsOnline}" Command="{Binding BackToCatalogCommand}" />
        <Button Content="Try to connect" IsVisible="{Binding !IsOnline}" Command="{Binding ReconnectCommand}" />
      </StackPanel>
    </Grid>

    <StackPanel DockPanel.Dock="Top" Spacing="8">
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
      <TextBlock Classes="info" IsVisible="{Binding IsEmpty}"
                 Text="Nothing has been downloaded yet. Download a sitting from the catalog while you are online." />
      <TextBlock Classes="info" Text="{Binding StatusMessage}"
                 IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>

    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Sittings}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="12" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:LocalSittingItem">
            <Border Classes="item">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Classes="itemTitle" Text="{Binding ExamTitle}" />
                    <Border Classes="badge" IsVisible="{Binding IsInProgress}">
                      <TextBlock Text="In progress" />
                    </Border>
                  </StackPanel>
                  <TextBlock Classes="info" Text="{Binding Subject}" />
                  <TextBlock Classes="info">
                    <Run Text="{Binding When}" />
                    <Run Text=" · " />
                    <Run Text="{Binding Status}" />
                  </TextBlock>
                  <TextBlock Classes="info" Text="{Binding SubmissionStatus}" IsVisible="{Binding IsSealed}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Border Classes="badge" IsVisible="{Binding IsHandedIn}">
                    <TextBlock Text="Handed in" />
                  </Border>
                  <Button Content="Hand in now" IsVisible="{Binding IsWaitingToHandIn}"
                          Command="{Binding $parent[ItemsControl].((vm:DownloadedExamsViewModel)DataContext).HandInCommand}"
                          CommandParameter="{Binding}" />
                  <Button Classes="accent" Content="Enter code" IsVisible="{Binding CanEnter}"
                          Command="{Binding $parent[ItemsControl].((vm:DownloadedExamsViewModel)DataContext).OpenCommand}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
