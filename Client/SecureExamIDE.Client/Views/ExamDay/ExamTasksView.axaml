<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SecureExamIDE.Client.ViewModels.ExamDay"
             x:Class="SecureExamIDE.Client.Views.ExamDay.ExamTasksView"
             x:DataType="vm:ExamTasksViewModel">
  <DockPanel Margin="24">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel Spacing="4">
        <TextBlock Classes="title" Text="{Binding ExamTitle}" />
        <TextBlock Classes="info" Text="{Binding Details}" />
      </StackPanel>
      <Button Grid.Column="1" VerticalAlignment="Top" Content="Lock the exam" Command="{Binding LockCommand}" />
    </Grid>

    <Grid ColumnDefinitions="260,16,*">
      <Border Classes="item" Padding="4">
        <ListBox ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ExamTaskItem">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="info" Text="{Binding Size}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Border Grid.Column="2" Classes="item" Padding="0">
        <Panel>
          <TextBox IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0"
                   FontFamily="Consolas, Menlo, monospace"
                   Text="{Binding SelectedText}" IsVisible="{Binding IsSelectedTextShown}" />
          <TextBlock Classes="info" Margin="16" TextWrapping="Wrap" IsVisible="{Binding IsSelectedBinary}"
                     Text="This file cannot be shown here yet. PDF tasks will open inside the exam workspace, which is the next step." />
        </Panel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
