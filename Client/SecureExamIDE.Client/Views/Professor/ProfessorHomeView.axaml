<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SecureExamIDE.Client.ViewModels.Professor"
             x:Class="SecureExamIDE.Client.Views.Professor.ProfessorHomeView"
             x:DataType="vm:ProfessorHomeViewModel">
  <Panel>
    <DockPanel Classes="page">
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,24">
        <StackPanel Spacing="4">
          <TextBlock Classes="title" Text="{Binding Greeting}" />
          <TextBlock Classes="info" Text="{Binding Details}" />
        </StackPanel>
        <Button Grid.Column="1" VerticalAlignment="Top" Content="Sign out of this computer"
                Command="{Binding SignOutCommand}" />
      </Grid>

      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
        <StackPanel Spacing="2">
          <TextBlock Classes="heading" Text="Your exams" />
          <TextBlock Classes="info"
                     Text="An exam starts as a draft you can still correct. Publishing puts it in the students' catalog for good." />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
          <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" MinWidth="130" />
          <Button Content="All sittings" Command="{Binding OpenAllSittingsCommand}" />
          <Button Content="Refresh" Command="{Binding LoadCommand}" />
          <Button Classes="accent" Content="New exam" Command="{Binding NewExamCommand}" />
        </StackPanel>
      </Grid>

      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,12,0,0">
        <Button Content="Previous" Command="{Binding PreviousPageCommand}" />
        <TextBlock VerticalAlignment="Center" Text="{Binding PageLabel}" />
        <Button Content="Next" Command="{Binding NextPageCommand}" />
      </StackPanel>

      <StackPanel DockPanel.Dock="Top" Spacing="8">
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
        <TextBlock Classes="error" Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Classes="success" Text="{Binding StatusMessage}"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Classes="info" Text="You have not created any exams yet." IsVisible="{Binding IsEmpty}" />
      </StackPanel>

      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Exams}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="12" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MyExamItem">
              <Border Classes="item">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Classes="tile"><Path Data="{StaticResource IconExam}" /></Border>
                  <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Classes="itemTitle" Text="{Binding Title}" />
                      <Border Classes="badge">
                        <TextBlock Text="{Binding Status}" />
                      </Border>
                    </StackPanel>
                    <TextBlock Classes="info" Text="{Binding Subject}" />
                    <TextBlock Classes="info" Text="{Binding Contents}" />
                    <TextBlock Classes="info" Text="{Binding When}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="accent" Content="Open"
                            Command="{Binding $parent[ItemsControl].((vm:ProfessorHomeViewModel)DataContext).OpenExamCommand}"
                            CommandParameter="{Binding}" />
                    <Button Content="Edit" IsVisible="{Binding IsDraft}"
                            Command="{Binding $parent[ItemsControl].((vm:ProfessorHomeViewModel)DataContext).EditExamCommand}"
                            CommandParameter="{Binding}" />
                    <Button Content="Delete" IsVisible="{Binding IsDraft}"
                            Command="{Binding $parent[ItemsControl].((vm:ProfessorHomeViewModel)DataContext).AskToDeleteCommand}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>

    <!-- Asked inside the window rather than in a dialog, the way the exam screens do it. -->
    <Border IsVisible="{Binding IsConfirmingDelete}"
            Classes="scrim">
      <Border Classes="card" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
        <StackPanel Classes="form">
          <TextBlock Classes="heading" Text="Delete this draft?" />
          <TextBlock Classes="info" TextWrapping="Wrap" Text="{Binding DeleteQuestion}" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Keep it" Command="{Binding CancelDeleteCommand}" />
            <Button Classes="accent" Content="Delete" Command="{Binding ConfirmDeleteCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Panel>
</UserControl>
